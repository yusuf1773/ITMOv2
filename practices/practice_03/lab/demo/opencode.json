{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-practice03-qwen8b",
  "small_model": "ollama/itmo-practice03-qwen8b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-practice03-qwen8b": {
          "name": "Qwen3 8B local 16k",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "external_directory": "deny"
      }
    }
  },
  "enabled_providers": [
    "ollama"
  ],
  "share": "disabled"
}
