      "id": "023ca813-0f0f-4422-b17f-545294225e14",
      "name": "Check review not done"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all();\nconst files = input.flatMap(item => {\n  const value = item.json;\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value.data)) return value.data;\n  return [value];\n});\nif (files.length === 0) throw new Error('GitHub returned no changed files');\n\nconst hunks = [];\nconst skipped = [];\nfor (const file of files) {\n  if (typeof file.patch !== 'string' || !file.filename) {\n    skipped.push(file.filename ?? '(unknown file)');\n    continue;\n  }\n  let current = null;\n  let oldLine = 0;\n  let newLine = 0;\n  for (const text of file.patch.split('\\n')) {\n    const match = text.match(/^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n    if (match) {\n      oldLine = Number(match[1]);\n      newLine = Number(match[2]);\n      current = { id: hunks.length + 1, path: file.filename, code: [text], candidates: [] };\n      hunks.push(current);\n      continue;\n    }\n    if (!current) continue;\n    current.code.push(text);\n    if (text.startsWith('+')) {\n      current.candidates.push({ line: newLine, side: 'RIGHT', code: text.slice(1) });\n      newLine++;\n    } else if (text.startsWith('-')) {\n      current.candidates.push({ line: oldLine, side: 'LEFT', code: text.slice(1) });\n      oldLine++;\n    } else if (text.startsWith(' ')) {\n      oldLine++;\n      newLine++;\n    }\n  }\n}\nconst reviewable = hunks.filter(h => h.candidates.length > 0);\nif (reviewable.length === 0) throw new Error('No text diff hunks are available for inline review');\nreturn [{ json: { hunks: reviewable, skipped_files: skipped } }];"
      },
      "id": "337fc9f7-19fa-45ce-b151-399e7b54e759",
      "name": "Prepare diff hunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        2672
      ]
    },
    {
      "parameters": {
        "jsCode": "const context = $('Prepare diff hunks').first().json;\nconst rawOutput = $json.output;\nconst result = typeof rawOutput === 'string'\n  ? JSON.parse(rawOutput.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, ''))\n  : rawOutput;\n\nif (!result || !Array.isArray(result.comments)) {\n  throw new Error('AI did not return a comments array');\n}\n\nconst hunksById = new Map(context.hunks.map(hunk => [hunk.id, hunk]));\nconst reviewedHunkIds = new Set();\nconst usedPositions = new Set();\nconst comments = result.comments.map(comment => {\n  if (!comment || !Number.isInteger(comment.hunk_id)) {\n    throw new Error('AI returned an invalid hunk_id');\n  }\n\n  const hunk = hunksById.get(comment.hunk_id);\n  if (!hunk) throw new Error('AI returned an unknown hunk_id: ' + comment.hunk_id);\n\n  const { line, side, body } = comment;\n  if (!Number.isInteger(line) || !['RIGHT', 'LEFT'].includes(side)) {\n    throw new Error('AI returned an invalid line or side');\n  }\n  if (typeof body !== 'string' || !body.trim() || body.length > 1200) {\n    throw new Error('Invalid review comment');\n  }\n  if (!hunk.candidates.some(candidate => candidate.line === line && candidate.side === side)) {\n    throw new Error('AI chose a line outside changed lines of hunk ' + hunk.id);\n  }\n\n  const position = JSON.stringify([hunk.path, line, side]);\n  if (usedPositions.has(position)) {\n    throw new Error('AI returned duplicate comments for ' + hunk.path + ' ' + side + ':' + line);\n  }\n  usedPositions.add(position);\n  reviewedHunkIds.add(hunk.id);\n  return { path: hunk.path, line, side, body: body.trim() };\n});\n\nfor (const hunk of context.hunks) {\n  if (!reviewedHunkIds.has(hunk.id)) throw new Error('AI missed hunk ' + hunk.id);\n}\n\nconst skippedNote = context.skipped_files.length\n  ? ' Файлов без текстового patch: ' + context.skipped_files.length + '.'\n  : '';\nreturn [{\n  json: {\n    review_request: {\n      event: 'COMMENT',\n      body: 'Автоматическое ревью: комментарии привязаны к изменённым строкам.' + skippedNote,\n      comments,\n    },\n    reviewed_hunks: reviewedHunkIds.size,\n  },\n}];"
      },
